# Copia este archivo a .env y completa los valores. .env está en .gitignore.

# --- Requeridas ---
# PAT de Azure DevOps (scopes: Work Items, Code; Identity (Read) si usas correo/nombre en repos.reviewers)
AZURE_DEV_KEY=
# Credenciales de SIGES
SIGES_USER=
SIGES_PASS=

# --- Opcionales ---
# API key de Anthropic: solo para interpretar prosa (módulo Horas) y el agente de Utilidades
ANTHROPIC_API_KEY=
# Modelos (valores por defecto en el código)
# TIMETRACK_MODEL=claude-haiku-5-5
# UTILIDADES_MODEL=claude-sonnet-5-5
# Hosts extra permitidos por el dashboard, separados por coma
# DASHBOARD_ALLOWED_HOSTS=
